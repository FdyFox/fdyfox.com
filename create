#!/usr/bin/env python3
"""Neue Inhalte anlegen. Ohne Argumente gibt es ein Menü.

  ./create logbuch [name]              Logbuch-Eintrag (ohne Name: heute)
  ./create bastelstube <name>          Bastelstube-Beitrag
  ./create wiki <kategorie/name>       Wiki-Seite
  ./create page <name>                 Einzelne Seite
  ./create brettspiel <name> [bgg-id]  Brettspiel, Steckbrief von BoardGameGeek
  ./create film <name> [tmdb-id]       Film, Steckbrief und Poster von TMDB

Namen mit Leerzeichen in Anführungszeichen: ./create film "Plötzlich Prinzessin 2"
"""

import os
import shutil
import subprocess
import sys
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent
HUGO = shutil.which("hugo") or str(Path.home() / ".local/bin/hugo")
# Neue Beiträge mit deutscher Zeit (+01:00/+02:00) statt UTC anlegen
ENV = {**os.environ, "TZ": "Europe/Berlin", "HUGO": HUGO}


def hugo_new(path, kind=None):
    if (ROOT / path).exists():
        sys.exit(f"Gibt es schon: {path}")
    cmd = [HUGO, "new"] + (["--kind", kind] if kind else []) + [path]
    subprocess.run(cmd, cwd=ROOT, env=ENV, check=True, stdout=subprocess.DEVNULL)
    print(f"→ Erstellt: {path}")


def logbuch(name=None):
    name = name or date.today().isoformat()
    # Name mit Datum vorne (2026-11-23-…) landet in dessen Monat, sonst im aktuellen
    monat = name[:7] if len(name) >= 7 and name[:4].isdigit() and name[4] == "-" and name[5:7].isdigit() \
        else date.today().strftime("%Y-%m")
    hugo_new(f"content/logbuch/{monat.replace('-', '/')}/{name}/index.md")


def bastelstube(name):
    hugo_new(f"content/bastelstube/{name}.md")


def wiki(name):
    hugo_new(f"content/wiki/{name}.md", kind="wiki")


def page(name):
    hugo_new(f"content/{name}.md")


def brettspiel(*args):
    sys.exit(subprocess.run([sys.executable, ROOT / "scripts/brettspiel-neu.py", *args], env=ENV).returncode)


def film(*args):
    sys.exit(subprocess.run([sys.executable, ROOT / "scripts/film-neu.py", *args], env=ENV).returncode)


# Art: (Funktion, Beschreibung, Frage nach dem Namen, Name Pflicht, Frage nach der ID)
ARTEN = {
    "logbuch":     (logbuch,     "Logbuch-Eintrag",    "Name (leer = heute)",  False, None),
    "bastelstube": (bastelstube, "Bastelstube-Beitrag", "Name",                True,  None),
    "wiki":        (wiki,        "Wiki-Seite",          "Kategorie/Name",      True,  None),
    "page":        (page,        "Einzelne Seite",      "Name",                True,  None),
    "brettspiel":  (brettspiel,  "Brettspiel (BGG)",    "Name",                True,  "BGG-ID (leer = suchen)"),
    "film":        (film,        "Film (TMDB)",         "Titel",               True,  "TMDB-ID (leer = suchen)"),
}


def ask(frage):
    try:
        return input(f"{frage}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)


def menu():
    namen = list(ARTEN)
    for i, art in enumerate(namen, 1):
        print(f"  {i}) {ARTEN[art][1]}")
    wahl = ask("Was anlegen?")
    art = namen[int(wahl) - 1] if wahl.isdigit() and 0 < int(wahl) <= len(namen) else wahl
    if art not in ARTEN:
        sys.exit(f"Unbekannt: {wahl}")
    func, _, frage, pflicht, id_frage = ARTEN[art]
    name = ask(frage)
    if pflicht and not name:
        sys.exit("Abgebrochen: kein Name")
    args = [name] if name else []
    if id_frage and (gid := ask(id_frage)):
        args.append(gid)
    func(*args)


def main():
    args = sys.argv[1:]
    if not args:
        return menu()
    if args[0] in ("-h", "--help", "help"):
        return print(__doc__.strip())
    art, rest = args[0], args[1:]
    if art not in ARTEN:
        sys.exit(f"Unbekannt: {art}\n\n{__doc__.strip()}")
    func, _, frage, pflicht, _ = ARTEN[art]
    if pflicht and not rest:
        sys.exit(f"{frage} fehlt. Beispiel: ./create {art} …")
    if art in ("brettspiel", "film"):
        return func(*rest)
    # Ohne Anführungszeichen getippte Wörter zu einem Namen zusammenfassen
    func(" ".join(rest).replace(" ", "-") if rest else None)


if __name__ == "__main__":
    main()
